<?xml version="1.0" encoding="utf-8"?>
<!--
  FileEncryptor 的 MSIX 清单（用于 Microsoft Store 提交 / 侧载）。

  ⚠️ 提交到 Store 之前必须替换 Publisher：
     Partner Center → 产品 → 产品标识 → 「包/标识名」与「发布者 ID」。
     Publisher 形如 CN=8B1A2C3D-....（不是商店 Product ID，也不是 Package Name）。
     下面留了占位符 REPLACE_WITH_PARTNER_CENTER_PUBLISHER，未替换时
     Store 会拒绝该包（错误 0x80073CF9 / Publisher 不匹配）。

  Identity/Name 用的是 MSIX 包标识名（PublisherId.AppName），
  商店 Product ID 9PK12VV60DDN 只用于商店链接，与这里无关。
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity Name="7C5755A7.FileEncryptorTool"
            Publisher="CN=REPLACE_WITH_PARTNER_CENTER_PUBLISHER"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FileEncryptor</DisplayName>
    <PublisherDisplayName>虞子尧</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>基于 AES-256-GCM 与 PBKDF2 的文件加密工具，支持可否认加密与安全删除。</Description>
  </Properties>

  <Dependencies>
    <!-- MSIX 本身要求 Windows 10 1607+；便携版 exe 仍可在 Windows 8+ 上运行 -->
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <!-- 桌面（全信任）应用：EntryPoint 固定为 Windows.FullTrustApplication -->
    <Application Id="App" Executable="FileEncryptor.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="FileEncryptor"
          Description="基于 AES-256-GCM 与 PBKDF2 的文件加密工具"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\Square71x71Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- 桌面程序需要全信任能力，否则无法读写用户文件 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
